}

const handleCurriculumFileRemoved = () => {
  curriculumWorkflowModel.file = null
  curriculumWorkflowModel.fileUrl = ''
  curriculumWorkflowModel.fileName = ''
}

const openCourseStudyPlanHybridModal = () => {
