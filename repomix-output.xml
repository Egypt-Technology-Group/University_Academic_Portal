<file path="frontend/src/style.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    scroll-behavior: smooth;
  }
  
  body {
    @apply bg-slate-50 text-slate-800 antialiased font-sans min-h-screen flex flex-col overflow-x-hidden;
  }

  /* Responsive Table Container */
  .table-responsive {
    @apply w-full overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0 scrollbar-thin;
    -webkit-overflow-scrolling: touch;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f5f9;
  }
  ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
}

@layer utilities {
  /* Direction-aware logical properties */
  .rtl-flip {
    [dir="rtl"] & {
      transform: scaleX(-1);
    }
  }

  /* Glassmorphism */
  .glass-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .glass-navy {
    background: rgba(10, 37, 64, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Academic Gradient Overlays */
  .bg-hero-gradient {
    background: linear-gradient(135deg, #0A2540 0%, #0F3460 50%, #1A365D 100%);
  }

  .bg-gold-gradient {
    background: linear-gradient(135deg, #D4AF37 0%, #C59B27 100%);
  }
}

/* Print Styles for Transcripts and Application Receipts */
@media print {
  body {
    background: white !important;
    color: black !important;
  }

  .no-print,
  nav,
  footer,
  header,
  .announcement-bar,
  button,
  .breadcrumbs {
    display: none !important;
  }

  .print-only {
    display: block !important;
  }

  .printable-area {
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
    border: none !important;
    width: 100% !important;
  }
}

/* Page transitions */
.fade-enter-active,
.fade-leave-active {
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.fade-enter-from {
  opacity: 0;
  transform: translateY(6px);
}

.fade-leave-to {
  opacity: 0;
  transform: translateY(-6px);
}

/* RichText HTML Content Typography & RTL/LTR Formatting */
.prose {
  color: #334155;
  line-height: 1.75;
}

.prose p {
  margin-top: 0.75em;
  margin-bottom: 0.75em;
}

.prose h1, .prose h2, .prose h3, .prose h4 {
  color: #0b192c;
  font-weight: 800;
  line-height: 1.35;
  margin-top: 1.25em;
  margin-bottom: 0.5em;
}

.prose h2 {
  font-size: 1.35rem;
}

.prose h3 {
  font-size: 1.15rem;
}

.prose ul {
  list-style-type: disc;
  padding-inline-start: 1.5rem;
  margin-top: 0.75em;
  margin-bottom: 0.75em;
}

.prose ol {
  list-style-type: decimal;
  padding-inline-start: 1.5rem;
  margin-top: 0.75em;
  margin-bottom: 0.75em;
}

.prose li {
  margin-top: 0.25em;
  margin-bottom: 0.25em;
}

.prose blockquote {
  border-inline-start: 4px solid #eab308;
  padding-inline-start: 1rem;
  margin: 1em 0;
  color: #475569;
  font-style: italic;
  background-color: #f8fafc;
  padding-block: 0.5rem;
  border-radius: 0.375rem;
}

.prose a {
  color: #0284c7;
  text-decoration: underline;
  font-weight: 600;
}

.prose a:hover {
  color: #0369a1;
}

.prose strong, .prose b {
  color: #0f172a;
  font-weight: 700;
}

.prose u {
  text-decoration: underline;
}

.prose em, .prose i {
  font-style: italic;
}
