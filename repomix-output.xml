  masterStudyPlanFileName.value = ''
}

const submitCurriculumBlueprintUpload = () => {
  if (curriculumWorkflowModel.file) {
    masterStudyPlanFileUrl.value = URL.createObjectURL(curriculumWorkflowModel.file)
